# Classic PAT with repo + read:user scopes
PAT_1=ghp_xxxxxxxxxxxxxxxxxxxx
# Only these usernames may be rendered (comma-separated). Leave empty to allow anyone (not recommended).
WHITELIST=
# Cache rendered cards for this long
CACHE_SECONDS=14400
PORT=9000
# --- profile/README.md generation (npm run readme) ---
# Public URL of this service; cards in the generated README point here. Empty = http://localhost:PORT
CARDS_URL=
# GitHub username for the README (defaults to the first WHITELIST entry)
GITHUB_USER=
# Links under the hero and in the contact row; leave empty to hide
LINKEDIN_URL=
WEBSITE_URL=
EMAIL=
